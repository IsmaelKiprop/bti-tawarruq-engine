# Copy to .env on the customer host. Do not commit secrets.

DEPLOYMENT_MODE=onprem
ENABLED_PRODUCTS=kenya
BRAND_NAME=Your Bank
CORS_ORIGINS=https://ops.your-bank.example
ONPREM_INSTITUTION_NAME=Your Bank
ONPREM_INSTITUTION_CODE=SITE

AUTH_ENABLED=true
OPS_SESSION_SECRET=replace-with-long-random-string
OPS_BOOTSTRAP_ADMIN_EMAIL=admin@your-bank.example
OPS_BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstBoot!
OPS_SEED_USERS=true
OPS_SEED_PASSWORD=ChangeMeOnFirstBoot!
OPS_SEED_EMAIL_DOMAIN=your-bank.example

PUBLIC_API_BASE_URL=https://api.your-bank.example
PORTAL_PUBLIC_URL=https://ops.your-bank.example
PORTAL_BIND=8080

INTEGRATION_ENCRYPTION_KEY=
POSTGRES_PASSWORD=replace-with-strong-db-password

# Primary book is Postgres `tawarruq` (DATABASE_URL in compose).
# Shariah *mirror* defaults to SQLite in ./data — not in pg_dump.
# For production on-prem, CREATE DATABASE tawarruq_audit; then:
# SHARIAH_AUDIT_DATABASE_URL=postgresql+psycopg://tawarruq:replace-with-strong-db-password@postgres:5432/tawarruq_audit
SHARIAH_AUDIT_SERVICE_URL=http://shariah-audit:8001
SHARIAH_AUDIT_DATABASE_URL=sqlite:////app/data/shariah_audit.db

KENYA_INTEGRATION_MODE=mock
SEDANIA_MODE=mock

SMTP_HOST=
SMTP_FROM=ops@your-bank.example
