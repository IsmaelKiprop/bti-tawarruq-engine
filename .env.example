# Platform public URL — builds per-institution callback paths automatically
PUBLIC_API_BASE_URL=https://your-engine.example.com

# Encrypt institution secrets at rest (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
INTEGRATION_ENCRYPTION_KEY=

# =============================================================================
# Kenya integration mode
# =============================================================================
# mock = synchronous dev/test (run-full-flow, no Daraja credentials)
# live = real Daraja, MNO, broker, Airtel APIs + async callbacks
KENYA_INTEGRATION_MODE=mock

# --- Safaricom Daraja (M-Pesa) ---
# Register at https://developer.safaricom.co.ke/
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_INITIATOR_NAME=
# RSA-encrypted initiator password (see INTEGRATIONS.md)
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_COMMAND_ID=BusinessPayment

# Public HTTPS URLs registered in Daraja portal (use ngrok for local dev)
MPESA_B2C_RESULT_URL=https://your-host/api/v1/kenya/callbacks/mpesa/b2c/result
MPESA_B2C_TIMEOUT_URL=https://your-host/api/v1/kenya/callbacks/mpesa/b2c/timeout
MPESA_STK_PASSKEY=
MPESA_STK_CALLBACK_URL=https://your-host/api/v1/kenya/callbacks/mpesa/stk
MPESA_STATUS_RESULT_URL=https://your-host/api/v1/kenya/callbacks/mpesa/b2c/result
MPESA_STATUS_TIMEOUT_URL=https://your-host/api/v1/kenya/callbacks/mpesa/b2c/timeout

# --- Safaricom MNO airtime partner API ---
MNO_SAFARICOM_API_URL=
MNO_SAFARICOM_API_KEY=
MNO_SAFARICOM_DEALER_CODE=

# --- Airtel Kenya (airtime + Airtel Money disbursement) ---
MNO_AIRTEL_API_URL=
MNO_AIRTEL_TOKEN_URL=
MNO_AIRTEL_CLIENT_ID=
MNO_AIRTEL_CLIENT_SECRET=

# MNO posts possession confirmation here
MNO_POSSESSION_CALLBACK_URL=https://your-host/api/v1/kenya/callbacks/mno/possession

# --- Independent third-party broker liquidation (No-Inah OTC desk) ---
BROKER_LIQUIDATION_API_URL=
BROKER_LIQUIDATION_API_KEY=

# --- Python Shariah audit microservice (append-only mirror) ---
SHARIAH_AUDIT_SERVICE_URL=
SHARIAH_AUDIT_SERVICE_TOKEN=
SHARIAH_AUDIT_DATABASE_URL=sqlite:///./data/shariah_audit.db

# =============================================================================
# Core engine
# =============================================================================
DATABASE_URL=sqlite:///./tawarruq.db

AMANAH_ENABLED=true
AMANAH_POLL_INTERVAL_SECONDS=5
AMANAH_WRITE_ENABLED=true
AMANAH_CERTIFICATE_TIMEOUT_SECONDS=300
AMANAH_ESCALATION_WEBHOOK_URL=

# Malaysia commodity desk: bsas (Suq Al-Sila') or eiger
MALAYSIA_COMMODITY_DESK=bsas
BSAS_LIVE_API_URL=
BSAS_LIVE_API_KEY=
EIGER_API_URL=
EIGER_API_KEY=
EIGER_ORDER_PATH=/v1/orders
EIGER_CERTIFICATE_PATH=/v1/certificates/{ref}

MANUAL_BRIDGE_INBOX_DIR=./data/manual_bridge
MANUAL_BRIDGE_EMAIL_ENABLED=false
MANUAL_BRIDGE_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=amanah@bti-fintech.local
PORTAL_PUBLIC_URL=http://127.0.0.1:5173
CUSTOMER_MAIL_DIR=./data/customer_mail

AUTH_ENABLED=false
API_KEY_HEADER=X-API-Key
# API key / ops user roles: platform_admin | institution_admin | institution_ops | read_only
# Portal login uses email/password; session secret signs Bearer tokens
OPS_SESSION_SECRET=
OPS_BOOTSTRAP_ADMIN_EMAIL=admin@bti.local
OPS_BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!123
CALLBACK_AUTH_TOKEN=
CALLBACK_AUTH_HEADER=X-Callback-Token

WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3

LOG_LEVEL=INFO
